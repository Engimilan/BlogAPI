{
  "openapi": "3.1.1",
  "info": {
    "title": "blogapi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7012"
    },
    {
      "url": "http://localhost:5185"
    }
  ],
  "paths": {
    "/bloggers/all": {
      "get": {
        "tags": [
          "Blogger"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/bloggers/byId": {
      "get": {
        "tags": [
          "Blogger"
        ],
        "parameters": [
          {
            "name": "Id",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Blogger"
    }
  ]
}